# ============================================================
# Copia este archivo como .env y rellena con tus datos reales.
# NUNCA subas .env a git (ya está en .gitignore).
# ============================================================

# --- Supabase / Base de datos ---
# En Supabase: Project Settings → Database → Connection string
#
# DATABASE_URL: usar el "Connection pooling" (puerto 6543, modo transaction)
#   — es el que debe usar la app en producción/serverless
# DIRECT_URL: usar la conexión directa (puerto 5432)
#   — solo la usa Prisma para migraciones (prisma migrate)

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase / Auth y Storage (si se usan sus servicios además de la BD) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # SOLO en servidor, nunca exponer al cliente

# --- App / next-auth v5 ---
AUTH_URL="https://area.carolinasanchezgirona.com"
AUTH_SECRET="generar-con-openssl-rand-base64-32"

# --- Email transaccional (invitaciones, recordatorios) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="no-reply@carolinasanchezgirona.com"

# --- Sistema de citas de Dememoria (proyecto Supabase aparte) ---
# Sección solo para Carolina, no forma parte del producto multiusuario
# de Mineuri. Server-side únicamente, nunca exponer al navegador.
CITAS_SUPABASE_URL="https://grgyvdxkjdstdyumdfyg.supabase.co"
CITAS_SUPABASE_SERVICE_ROLE_KEY="pega-aqui-la-service-role-key"
